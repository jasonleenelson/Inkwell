  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Inkwell</name>
  <summary>Simple Markdown notes in folders</summary>
  <description>
    <p>
      Inkwell is a small, fast notes app. Notes are plain Markdown files in a
      folder you choose, and the sidebar shows your folders as an expandable tree.
    </p>
    <ul>
      <li>Create, rename, move and delete notes and folders</li>
      <li>Drag notes between folders</li>
      <li>Saves automatically as you type</li>
      <li>Markdown highlighting with buttons and shortcuts for common formatting</li>
      <li>Note templates per folder, with the date, time and other placeholders</li>
      <li>Picture and file attachments shown as thumbnails under the note</li>
      <li>Find in note, light and dark styles, works in narrow windows</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.jasonleenelson.Inkwell.desktop</launchable>
